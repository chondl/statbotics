# Rig environment — source before running any backend command in the rig.
# Usage:  set -a; source docs/superpowers/rig/rig.env; set +a
#
# The rig mirrors production: NO database. Persistence and serving are
# DuckDB-over-Parquet + GCS blobs, against a local fake-gcs-server emulator.
# PROD is intentionally unset -> src/google/storage.py picks the non-prod
# bucket name "site_dev_v1".

# Db-less needs no flag: since DB retirement Phase 4 (2026-07-27) there is no
# database code left to switch on, so the rig only has to point storage at the
# emulator below.

# Point google-cloud-storage at the local fake-gcs-server emulator.
export STORAGE_EMULATOR_HOST=http://localhost:4443

# google-cloud-storage still tries to resolve a project for some calls;
# harmless dummy keeps it from probing metadata servers.
export GOOGLE_CLOUD_PROJECT=rig-local
export GCLOUD_PROJECT=rig-local
